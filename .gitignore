dist/
node_modules/
.env
.env.*
*.log
tools/__pycache__/

# QA, synthetic-render and local review artifacts must live OUTSIDE this
# repository: /home/user/workspace/ych_rehab_qa_artifacts/
# (qa/ = bedside and device captures, review-notes/ = generated findings).
# These patterns stay as a safety net so a stray local capture can never be
# staged again.
qa/
qa_*/
*_findings_*.md
*_handoff_*.md
*_audit_*.md
progress_repaired_*.md

# One-off local browser probes and preview captures. Keep the files for review,
# but prevent temporary root-level evidence from being staged accidentally.
/.tmp-*
/.v77-*
/preview_*.png
/v77-*.png
/*_local_report_*.md
